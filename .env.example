# PlanOpsis Mobile needs no secrets, API keys or accounts: everything runs on the device and the app
# makes no network requests.
#
# If a future integration needs configuration, add a placeholder here (never a real value), copy this
# file to `.env` for your own values, and keep `.env` out of git (it is listed in .gitignore).
#
# EXAMPLE_SERVICE_URL=https://api.example.com
# EXAMPLE_SERVICE_API_KEY=replace-me
